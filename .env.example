# Copy to `.env` (or `.env.local`) and fill in real values. Never commit the copy.
# `.gitignore` ignores `.env*` but re-includes this file, so keep placeholders only here.

# --- Database -----------------------------------------------------------------
# Postgres connection string used by Prisma (`prisma7.config.ts`) and the runtime
# client (`lib/prisma.ts`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- AI -----------------------------------------------------------------------
# Preferred name. `lib/llm/llmClient.ts` also accepts AI_API_KEY as a fallback.
OPENAI_API_KEY="sk-..."

# --- Guest identity -----------------------------------------------------------
# HMAC key for the guest-id cookie (`lib/guest-cookie.ts`). Required in production:
# without it the app refuses to mint or trust a guest cookie. Generate one with:
#   openssl rand -hex 32
GUEST_COOKIE_SECRET=""

# --- Clerk --------------------------------------------------------------------
# From the Clerk dashboard for this application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Cron ---------------------------------------------------------------------
# Shared secret checked by `app/api/cron/cleanup/route.ts`. The route returns 503
# while this is unset, so set it before wiring up a scheduler.
CRON_SECRET=""

# --- Optional -----------------------------------------------------------------
# Absolute origin used for metadata/openGraph URLs (`app/layout.tsx`). Defaults to
# http://localhost:3000 when unset; set it to the deployed origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
