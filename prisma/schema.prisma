// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum ContextMode {
  NORMAL
  EXAM_REVISION
  INTERVIEW_BASED
}

enum QuestionFormat {
  MCQ
  SENTENCE_BASED
  INTERVIEW_BASED
}

enum ExperienceLevel {
  FRESHER_0_1
  EXPERIENCED_3_PLUS
}

enum SourceType {
  TOPIC
  PDF
}

model User {
  id String @id // Clerk's `user_...` id, or `guest_<uuid>` for an anonymous visitor

  // Nullable because a guest has no email. Postgres treats NULLs as distinct in a unique
  // index, so any number of guest rows can coexist here.
  email     String?  @unique
  isGuest   Boolean  @default(false)
  credits   Int      @default(0) // 50 for a Clerk user, 20 for a guest — set when the row is created
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Feature Relations
  studyChats   StudyChat[]
  questionSets QuestionSet[]
  flashcards   FlashcardDeck[]
  quizzes      Quiz[]
  quizAttempts QuizAttempt[]
  creditLedger CreditLedger[]

  @@map("user")
}

/// One row per spent credit, so usage can be audited. The balance itself lives on User.credits.
model CreditLedger {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  feature   String // 'study-chat' | 'study-message' | 'question-set' | 'flash-quiz'
  cost      Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("creditledger")
}

// Contextual Study Model

model StudyChat {
  id               String         @id @default(uuid())
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String?
  title            String
  contextMode      ContextMode    @default(NORMAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  messages         StudyMessage[]
  latestResponseId String?

  @@unique([userId, id])
  @@index([userId])
  @@map("studychat")
}

model StudyMessage {
  id        String      @id @default(cuid())
  studyChat StudyChat?  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    String
  role      String // 'user'/'assistant'
  content   String
  modeUsed  ContextMode @default(NORMAL)
  createdAt DateTime    @default(now())

  @@index([chatId])
  @@map("studymessage")
}

// Question Genertor

model QuestionSet {
  id              String          @id @default(cuid())
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  topic           String
  format          QuestionFormat
  experienceLevel ExperienceLevel
  count           Int             @default(10)
  questions       Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@map("questionset")
}

// Flashcard and Quiz

model FlashcardDeck {
  id         String      @id @default(cuid())
  userId     String
  title      String
  topic      String
  sourceType SourceType  @default(TOPIC)
  sourceName String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards      Flashcard[]
  quizzes    Quiz[]

  @@index([userId])
  @@map("flashcardeck")
}

model Flashcard {
  id         String        @id @default(cuid())
  deckId     String
  order      Int
  front      String
  back       String
  hint       String?
  isMastered Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@index([deckId, order])
}

model Quiz {
  id         String     @id @default(cuid())
  userId     String
  deckId     String? // Set if generated from a FlashcardDeck; null if created standalone
  title      String
  topic      String
  sourceType SourceType @default(TOPIC)
  sourceName String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck      FlashcardDeck? @relation(fields: [deckId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([userId])
  @@index([deckId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  order         Int      @default(0)
  question      String   @db.Text
  options       String[] // 4 choices: ["O(1)", "O(n)", "O(log n)", "O(n^2)"]
  correctAnswer String // Must match the exact string of the correct choice
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, order])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizId         String
  userId         String
  score          Int
  totalQuestions Int
  percentage     Float
  timeSpent      Int?
  answers        Json
  createdAt      DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}
